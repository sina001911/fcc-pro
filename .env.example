# FCC Pro environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Paths ---
# FCC_CONFIG_DIR=/path/to/fcc-pro/config   # Override default ~/.fcc location

# --- Server ---
# FCC_HOST=127.0.0.1
# FCC_PORT=8000
# FCC_LOG_FILE=

# --- Proxy auth ---
# PROXY_AUTH_ENABLED=false
# PROXY_AUTH_TOKEN=

# --- Provider API keys (set only for providers you use) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
